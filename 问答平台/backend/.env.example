# 智能问答 SaaS 平台 · 环境变量样例
# 用法:复制为 backend/.env 并按环境填写;.env 不入库(见根目录 .gitignore)。
# 只有本文件中的键会被 app/config.py 读取,未列出的键不会生效。

# ---------------- 认证 ----------------
# 生产环境必须覆盖为强随机值(至少 32 位);默认值仅用于本地开发
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# ---------------- 数据库 ----------------
# 开发期默认 SQLite(零依赖):sqlite:///<backend>/qa.db
# 生产切换 MySQL 8.0(密码含 @ : / 等字符时须 URL 转义,@ → %40):
# DATABASE_URL=mysql+pymysql://smartqa:CHANGE_ME@127.0.0.1:3306/smartqa_saas?charset=utf8mb4
DATABASE_URL=sqlite:///qa.db
# 打开后打印每条 SQL,用于核对隔离钩子是否注入 tenant_id(模块 B 自测)
DB_ECHO=false

# ---------------- 可观测性 ----------------
LOG_LEVEL=INFO
LOG_JSON=true
APP_VERSION=0.2.0
# 单次依赖探测超时(秒):依赖挂掉时健康检查不能跟着挂
HEALTH_TIMEOUT_SECONDS=3

# ---------------- 模型服务 ----------------
# 留空表示使用内置本地模拟模型(local-simulation),不发起外部请求
# 阿里云百炼(DashScope)OpenAI 兼容端点示例,模型名建议 qwen-flash / qwen-plus
# (qwen-turbo 等旧模型会返回 429 limit_requests 速率限流,与余额无关):
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-flash
MODEL_BASE_URL=
# 留空时回退到系统环境变量 DASHSCOPE_API_KEY,密钥不必写进本文件
MODEL_API_KEY=
# 真实模型单次调用较慢,建议 30;健康探针另由 HEALTH_TIMEOUT_SECONDS 兜底
MODEL_TIMEOUT_SECONDS=3
MODEL_NAME=local-simulation

# ---------------- 问答缓存 ----------------
QA_CACHE_TTL_SECONDS=300

# ---------------- 限流(模块 E,双维度) ----------------
# 租户维度兜底阈值:API Key 自带 rate_limit_* 时以 Key 为准;JWT 登录态调用走这里
TENANT_RATE_LIMIT_PER_MINUTE=600
TENANT_RATE_LIMIT_PER_HOUR=20000

# ---------------- 用量汇总任务(模块 F) ----------------
# 后台定时把 usage_record 汇总进 usage_summary;<=0 表示不启动(仅手动刷新)
SUMMARY_REFRESH_INTERVAL_SECONDS=300
# 每次刷新回看的自然日窗口(含今日),用于补偿调度抖动/延迟落库
SUMMARY_REFRESH_LOOKBACK_DAYS=2
